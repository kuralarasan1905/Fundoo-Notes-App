{
  // ============================================================================
  // FUNDOO NOTES API - PRODUCTION CONFIGURATION
  // ============================================================================
  // This configuration file is used for PRODUCTION DEPLOYMENT ONLY
  // Update the connection string below with your actual production database server

  "ConnectionStrings": {
    // PRODUCTION: Update this connection string for your production environment
    // Replace YOUR_PRODUCTION_SERVER with your actual production database server
    // Examples:
    //   - Cloud: "Server=tcp:yourserver.database.windows.net,1433;..."
    //   - On-premise: "Server=192.168.1.100,1433;..."
    //   - Same server: "Server=KURALARASAN\\SQLEXPRESS;..." (with SQL Auth)
    "DefaultConnection": "Server=YOUR_PRODUCTION_SERVER;Database=FundooNotesDB;User Id=appuser;Password=kural1905;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  // JWT AUTHENTICATION SETTINGS - CRITICAL FOR PRODUCTION SECURITY
  // IMPORTANT: Change the SecretKey to a unique, strong value for production
  // The SecretKey must be at least 32 characters long and kept secret
  "JwtSettings": {
    "SecretKey": "your-production-super-secret-key-that-is-at-least-32-characters-long-and-very-secure",
    "Issuer": "FundooNotesAPI",
    "Audience": "FundooNotesClient",
    "ExpirationInMinutes": 60
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "your-production-email@gmail.com",
    "SenderPassword": "your-production-app-password",
    "SenderName": "Fundoo Notes"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "fundoo_notes": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/fundoo-notes-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errors/fundoo-notes-errors-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Error"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    }
  }
}
