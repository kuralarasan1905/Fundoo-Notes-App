{
  // ============================================================================
  // FUNDOO NOTES API - DEVELOPMENT CONFIGURATION
  // ============================================================================
  // This configuration file is used for LOCAL DEVELOPMENT ONLY
  // For production deployment, use appsettings.Production.json

  "ConnectionStrings": {
    // DEVELOPMENT: Local SQL Server Express with Windows Authentication
    // This connection string works only on the development machine (KURALARASAN)
    // Uses Windows Authentication (Integrated Security=true)
    "DefaultConnection": "Server=KURALARASAN\\SQLEXPRESS;Database=FundooNotesDB;Integrated Security=true;MultipleActiveResultSets=True;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30;",

    // TEMPLATE: Production connection string template (not used in development)
    // Replace placeholders with actual production values in appsettings.Production.json
    "ProductionConnection": "Server=YOUR_PRODUCTION_SERVER;Database=FundooNotesDB;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "FundooNotesAPI",
    "Audience": "FundooNotesClient",
    "ExpirationInMinutes": 60
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 465,
    "SenderEmail": "arasankural91@gmail.com",
    "SenderPassword": "jaob vagd aavz ioee",
    "SenderName": "Fundoo Notes"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "fundoo_notes": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fundoo-notes-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errors/fundoo-notes-errors-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Error"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
